# ══════════════════════════════════════════════════════════════
# SubsidyLens Backend — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# ══════════════════════════════════════════════════════════════
# REQUIRED (без этих переменных приложение НЕ запустится)
# ══════════════════════════════════════════════════════════════

# Supabase project URL
# Format: https://[project-id].supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service_role key (backend writes, bypasses RLS)
# Dashboard → Settings → API → Project API keys → service_role (secret)
SUPABASE_KEY=your-service-role-key

# Postgres direct connection URL (для атомарных ML writes и миграций)
# Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres.[ref]:[PASSWORD]@aws-0-...pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ══════════════════════════════════════════════════════════════
# AUTH — JWT Secret (обязательно!)
# ══════════════════════════════════════════════════════════════
#
# PRODUCTION: получите реальный JWT Secret из Supabase Dashboard:
#   1. https://supabase.com/dashboard → ваш проект
#   2. Settings (⚙️) → API
#   3. Прокрутите до "JWT Settings"
#   4. Скопируйте "JWT Secret"
#   5. Вставьте ниже:
#
# SUPABASE_JWT_SECRET=ваш_реальный_секрет_из_dashboard
#
# DEVELOPMENT (локальный запуск без Supabase аутентификации):
#   Раскомментируйте строку ниже. ВСЕ API endpoints будут доступны
#   без проверки токенов. НИКОГДА не используйте в production!
#
DEV_JWT_SECRET=dev-secret

# ══════════════════════════════════════════════════════════════
# SECURITY (recommended)
# ══════════════════════════════════════════════════════════════

# CORS whitelist (comma-separated). Defaults to FRONTEND_URL если пусто.
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Frontend URL (используется для CORS и редиректов)
FRONTEND_URL=http://localhost:5173

# ══════════════════════════════════════════════════════════════
# OPTIONAL
# ══════════════════════════════════════════════════════════════

# Supabase anon key (опционально — fallback на SUPABASE_KEY)
SUPABASE_ANON_KEY=your-anon-key

# Gemini AI (оставьте пустым для отключения AI-фич)
GOOGLE_API_KEY=

# Debug logging
DEBUG=0

# Port
PORT=8000

# Environment: development | production
ENVIRONMENT=development

# ══════════════════════════════════════════════════════════════
# MODEL STORAGE (Optional — S3/MinIO для артефактов)
# ══════════════════════════════════════════════════════════════
# MODEL_STORAGE_URL=http://localhost:9000
# MODEL_STORAGE_BUCKET=models
# MODEL_STORAGE_KEY=minioadmin
# MODEL_STORAGE_SECRET=minioadmin-secret

# ══════════════════════════════════════════════════════════════
# AUTO-ROLLBACK (включён по умолчанию)
# ══════════════════════════════════════════════════════════════
AUTO_ROLLBACK_ENABLED=1
AUTO_ROLLBACK_AUC_THRESHOLD=0.03
AUTO_ROLLBACK_F1_THRESHOLD=0.05
AUTO_ROLLBACK_CHECK_DELAY=300
AUTO_ROLLBACK_WINDOW=3600
