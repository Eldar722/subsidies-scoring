# ═══════════════════════════════════════════════════════════════
# SubsidyLens — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── SECRETS ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
**/.env

# ── LARGE BINARIES (не для git) ──────────────────────────────
backend/model.pkl
backend/model.pkl.bak
backend/model.pkl.tmp
backend/*.joblib
backend/models/
backend/data/subsidies.xlsx
backend/data/*.parquet
backend/data/*.csv

# ── RUNTIME / CACHES ─────────────────────────────────────────
backend/logs/
backend/json_cache/
backend/_archive/
backend/err*.txt
backend/uv*.txt
backend/out.txt

# ── PYTHON ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
env/
venv/
.venv/

# ── FRONTEND ─────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── DOCS (only README and ARCHITECTURE) ──────────────────────
*.md
!README.md
!ARCHITECTURE.md

# ── SYSTEM ───────────────────────────────────────────────────
*.log
*.sqlite3
Thumbs.db
desktop.ini
.vscode/
.idea/
