# ===== Subsidy Scoring — Environment Configuration =====
# Copy this file to .env and fill in actual values
# ⚠️ NEVER commit .env to git - it contains secrets

# --- Supabase Database ---
# Get these from https://app.supabase.com project settings
SUPABASE_URL=https://your-project.supabase.co
# BACKEND ONLY: Service role key with full database access
# ⚠️ NEVER expose this to frontend or client code
# This is the JWT token with service_role permissions
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend uses public anon key (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- AI Providers (choose one or both) ---
AI_PROVIDER=groq
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# --- Backend Configuration ---
FRONTEND_URL=http://localhost:5173
MODEL_PATH=model.pkl
DATA_PATH=data/subsidies.xlsx

# --- Frontend (Vite) Runtime ---
VITE_API_URL=http://localhost:8000
